# Copy to deploy/.env and fill in. This file holds secrets: never commit it.
# After changing it, recreate the container:
#   docker compose -f deploy/docker-compose.yml up -d --force-recreate

# --- Microsoft Entra application (README, step 2) ---
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
# The secret VALUE (not the secret ID)
GRAPH_CLIENT_SECRET=

# --- Where documents are stored in SharePoint ---
# The SITE address, not a link to a library page, e.g. https://contoso.sharepoint.com/sites/SAP_DOCS
SHAREPOINT_SITE_URL=
# Document library DISPLAY name, e.g. Documents or DOCS (empty = the site's default library)
SHAREPOINT_LIBRARY=Documents
# Folder inside the library for everything the adapter stores; created automatically (empty = library root)
SHAREPOINT_ROOT_PATH=SAP_DMS

# --- Access to the adapter itself ---
# Generate each with: openssl rand -hex 32
ADAPTER_API_KEY_S4=
ADAPTER_API_KEY_FIORI=
ADMIN_TOKEN=

# Optional: host ports, only if the defaults are already in use on the server
# (Ubuntu's Cockpit listens on 9090). Container ports do not change.
# BIND_ADDRESS is the host address the REST and SAP ports listen on (default 0.0.0.0; use a private
# interface address to avoid exposing them everywhere). The admin port is always 127.0.0.1.
#BIND_ADDRESS=0.0.0.0
#REST_PORT=8080
#CS_PORT=8090
#ADMIN_PORT=9090

# Optional: LOG_LEVEL=debug temporarily shows what SAP sends (secKey redacted, never bodies)
#LOG_LEVEL=info
